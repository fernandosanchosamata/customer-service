        <mxCell id="m7" value="7. Documento disponible" style="endArrow=open;html=1;rounded=0;dashed=1;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="490" as="sourcePoint" /><mxPoint x="652" y="490" as="targetPoint" /></mxGeometry></mxCell>
