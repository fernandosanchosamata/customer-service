        <mxCell id="m1" value="1. POST /auth-service/auth/login" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="215" as="sourcePoint" /><mxPoint x="280" y="215" as="targetPoint" /></mxGeometry></mxCell>
